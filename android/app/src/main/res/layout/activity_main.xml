<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#082832"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/riverBox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:clipToOutline="true"
        app:cardBackgroundColor="#08323C"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#F4A698"
        app:strokeWidth="3dp">

        <com.skc45.drcr2.SalmonRunView
            android:id="@+id/salmonRun"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/kicker"
            android:textAllCaps="true"
            android:textColor="#F4A698"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/title"
            android:textColor="#FFF4EC"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/lede"
            android:textColor="#C9E4E8"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/opPlus"
                style="@style/Widget.DRCR2.Op"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="+" />

            <Button
                android:id="@+id/opMinus"
                style="@style/Widget.DRCR2.Op"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="−" />

            <Button
                android:id="@+id/opStar"
                style="@style/Widget.DRCR2.Op"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="*" />

            <Button
                android:id="@+id/opSlash"
                style="@style/Widget.DRCR2.Op"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:text="/" />
        </LinearLayout>

        <TextView
            android:id="@+id/tokenOut"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/token_card"
            android:fontFamily="monospace"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFE1D4"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
